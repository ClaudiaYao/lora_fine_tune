# AWS credentials (fill these in)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed for temporary credentials (STS / SSO); leave blank otherwise
AWS_REGION=

# Bedrock model to generate the training data with.
# Must be enabled for your account under Bedrock > Model access.
# Some newer models require an inference profile ID (e.g. "us.anthropic....").
BEDROCK_MODEL_ID=

# S3 bucket for upload_to_s3.py (the AWS key above needs s3:PutObject and s3:ListBucket on it).
# Files go to s3://<S3_BUCKET>/<S3_PREFIX>/...; leave S3_PREFIX blank to upload at the bucket root.
S3_BUCKET=
S3_PREFIX=lora-fine-tune
